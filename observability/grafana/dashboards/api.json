{
  "uid": "kantano-api",
  "title": "Kantano / API",
  "tags": ["kantano", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [
    {"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "query": "label_values(http_requests_total, environment)", "current": {"text": "local", "value": "local"}},
    {"name": "job", "type": "query", "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "query": "label_values(http_requests_total{environment=\"$environment\"}, job)", "current": {"text": "kantano-api", "value": "kantano-api"}}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests / second", "description": "Total API request rate over a five-minute window.", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{environment=\"$environment\",job=\"$job\"}[5m]))", "legendFormat": "requests/s"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 2, "type": "timeseries", "title": "Responses by status", "description": "API response rate grouped by HTTP status class.", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_requests_total{environment=\"$environment\",job=\"$job\"}[5m]))", "legendFormat": "HTTP {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 3, "type": "stat", "title": "5xx error ratio", "description": "Five-minute 5xx ratio. No traffic remains distinct from a zero error ratio.", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "(sum(rate(http_requests_total{environment=\"$environment\",job=\"$job\",status=~\"5xx|5..\"}[5m])) or 0 * sum(rate(http_requests_total{environment=\"$environment\",job=\"$job\"}[5m]))) / clamp_min(sum(rate(http_requests_total{environment=\"$environment\",job=\"$job\"}[5m])), 0.000001)"}], "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "No traffic", "color": "gray"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}}}, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}},
    {"id": 4, "type": "timeseries", "title": "Latency p50 / p95 / p99", "description": "Overall API latency percentiles over a five-minute window.", "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\"}[5m])))"},
      {"refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\"}[5m])))"},
      {"refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\"}[5m])))"}
    ], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 5, "type": "stat", "title": "Requests (range)", "description": "Approximate request count for the selected time range; Prometheus extrapolates counter boundaries.", "gridPos": {"x": 12, "y": 7, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "round(sum(increase(http_requests_total{environment=\"$environment\",job=\"$job\"}[$__range])))"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "No traffic"}}, "options":{"colorMode": "none", "graphMode": "area"}},
    {"id": 6, "type": "stat", "title": "In progress", "description": "Requests currently executing in the API process.", "gridPos": {"x": 18, "y": 7, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum(http_requests_inprogress{environment=\"$environment\",job=\"$job\"})"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "No data"}}},
    {"id": 7, "type": "timeseries", "title": "Latency by route (p95)", "description": "p95 latency grouped by normalized route handler.", "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\"}[5m])))", "legendFormat": "{{handler}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 8, "type": "timeseries", "title": "Database pool", "description": "SQLAlchemy pool capacity and current checkout state.", "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "kantano_db_pool_checked_out_connections{environment=\"$environment\",job=\"$job\"}", "legendFormat": "checked out"},
      {"refId": "B", "expr": "kantano_db_pool_available_connections{environment=\"$environment\",job=\"$job\"}", "legendFormat": "available"},
      {"refId": "C", "expr": "kantano_db_pool_size_connections{environment=\"$environment\",job=\"$job\"}", "legendFormat": "size"}
    ], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}},
    {"id": 9, "type": "logs", "title": "Correlated application logs", "description": "Structured API logs for the selected environment and time range.", "gridPos": {"x": 0, "y": 23, "w": 24, "h": 9}, "datasource": {"type": "loki", "uid": "kantano-loki"}, "targets": [{"refId": "A", "expr": "{environment=\"$environment\",service=\"$job\"} | json"}]},
    {"id": 10, "type": "stat", "title": "Cache hit ratio", "description": "Five-minute hit ratio for project read caches. Misses include cold and invalidated entries.", "gridPos": {"x": 0, "y": 32, "w": 6, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "(sum by (cache) (rate(kantano_cache_operations_total{environment=\"$environment\",job=\"$job\",operation=\"get\",result=\"hit\"}[5m])) or 0 * sum by (cache) (rate(kantano_cache_operations_total{environment=\"$environment\",job=\"$job\",operation=\"get\",result=~\"hit|miss\"}[5m]))) / clamp_min(sum by (cache) (rate(kantano_cache_operations_total{environment=\"$environment\",job=\"$job\",operation=\"get\",result=~\"hit|miss\"}[5m])), 0.000001)", "legendFormat": "{{cache}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 1, "noValue": "No cache traffic"}}, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}},
    {"id": 11, "type": "timeseries", "title": "Cache operations", "description": "Cache reads, writes and invalidations grouped by bounded cache and result labels.", "gridPos": {"x": 6, "y": 32, "w": 6, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (cache, operation, result) (rate(kantano_cache_operations_total{environment=\"$environment\",job=\"$job\"}[5m]))", "legendFormat": "{{cache}} {{operation}} {{result}}"}], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}},
    {"id": 12, "type": "timeseries", "title": "Cached routes p95", "description": "Five-minute p95 for the three project reads backed by Redis.", "gridPos": {"x": 12, "y": 32, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\",handler=\"/api/projects/{project_id}/columns\"}[5m])))", "legendFormat": "board"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\",handler=\"/api/projects/{project_id}/members\"}[5m])))", "legendFormat": "members"}, {"refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{environment=\"$environment\",job=\"$job\",handler=\"/api/projects/{project_id}/tags\"}[5m])))", "legendFormat": "tags"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}}},
    {"id": 13, "type": "stat", "title": "Redis memory", "description": "Memory currently allocated by the shared Redis instance.", "gridPos": {"x": 20, "y": 32, "w": 4, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "max(redis_memory_used_bytes{environment=\"$environment\"})", "legendFormat": "used"}], "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "noValue": "No data"}}, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true}}
  ]
}
