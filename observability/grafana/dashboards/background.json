{
  "uid": "kantano-background",
  "title": "Kantano / Background and realtime",
  "tags": ["kantano", "celery", "realtime"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [{"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "query": "label_values(up, environment)", "current": {"text": "local", "value": "local"}}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Outbox backlog", "description": "Unpublished events in the shared database. Duplicate process gauges are reduced with max, not summed.", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "max(kantano_outbox_unpublished_events{environment=\"$environment\"})"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "No data"}}},
    {"id": 2, "type": "stat", "title": "Oldest event age", "description": "Age of the oldest unpublished event. An empty outbox is shown as no pending event.", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "time() - max(kantano_outbox_oldest_created_timestamp_seconds{environment=\"$environment\"} > 0)"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "No pending event", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 120}]}}}},
    {"id": 3, "type": "stat", "title": "Publisher poll age", "description": "Seconds since the publisher completed its latest outbox poll.", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "time() - max(kantano_outbox_publisher_last_poll_timestamp_seconds{environment=\"$environment\"} > 0)"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "No heartbeat", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 90}]}}}},
    {"id": 4, "type": "stat", "title": "Stats update age", "description": "Seconds since the outbox aggregate statistics were refreshed.", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "time() - max(kantano_outbox_stats_last_update_timestamp_seconds{environment=\"$environment\"} > 0)"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "No heartbeat", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 90}]}}}},
    {"id": 10, "type": "stat", "title": "Celery worker", "description": "Prometheus scrape health for the Celery worker metrics endpoint.", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 4}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "min(up{environment=\"$environment\",job=\"kantano-celery-worker\"})"}], "fieldConfig": {"defaults": {"noValue": "NO DATA", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}, {"type": "special", "options": {"match": "null", "result": {"text": "NO DATA", "color": "gray"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 11, "type": "stat", "title": "Outbox publisher", "description": "Prometheus scrape health for the outbox publisher metrics endpoint.", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 4}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "min(up{environment=\"$environment\",job=\"kantano-outbox-publisher\"})"}], "fieldConfig": {"defaults": {"noValue": "NO DATA", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}, {"type": "special", "options": {"match": "null", "result": {"text": "NO DATA", "color": "gray"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 5, "type": "timeseries", "title": "Outbox publication results", "description": "Publisher outcomes per second, grouped by result.", "gridPos": {"x": 0, "y": 9, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (result) (rate(kantano_outbox_publish_total{environment=\"$environment\"}[5m]))", "legendFormat": "{{result}}"}], "fieldConfig": {"defaults": {"unit": "eps"}}},
    {"id": 6, "type": "timeseries", "title": "Celery attempts and retries", "description": "Task attempt outcomes per second, including retries and terminal results.", "gridPos": {"x": 12, "y": 9, "w": 12, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (result, task) (rate(kantano_celery_task_attempts_total{environment=\"$environment\"}[5m]))", "legendFormat": "{{task}} · {{result}}"}], "fieldConfig": {"defaults": {"unit": "eps"}}},
    {"id": 7, "type": "timeseries", "title": "Celery duration p95", "description": "p95 task attempt duration over ten minutes, grouped by task.", "gridPos": {"x": 0, "y": 16, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, task) (rate(kantano_celery_task_attempt_duration_seconds_bucket{environment=\"$environment\"}[10m])))", "legendFormat": "{{task}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 8, "type": "timeseries", "title": "RabbitMQ queue", "description": "Ready and unacknowledged messages plus attached consumers.", "gridPos": {"x": 8, "y": 16, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "sum(rabbitmq_queue_messages_ready{environment=\"$environment\"})", "legendFormat": "ready"},
      {"refId": "B", "expr": "sum(rabbitmq_queue_messages_unacked{environment=\"$environment\"})", "legendFormat": "unacked"},
      {"refId": "C", "expr": "sum(rabbitmq_queue_consumers{environment=\"$environment\"})", "legendFormat": "consumers"}
    ], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}},
    {"id": 9, "type": "timeseries", "title": "Realtime / WebSocket", "description": "Active realtime connections on the left axis and errors per second on the right axis.", "gridPos": {"x": 16, "y": 16, "w": 8, "h": 7}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "sum by (kind) (kantano_realtime_connections{environment=\"$environment\"})", "legendFormat": "connections {{kind}}"},
      {"refId": "B", "expr": "sum by (operation) (rate(kantano_realtime_errors_total{environment=\"$environment\"}[5m]))", "legendFormat": "errors {{operation}}"}
    ], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [{"matcher": {"id": "byRegexp", "options": "^errors .*"}, "properties": [{"id": "unit", "value": "eps"}, {"id": "custom.axisPlacement", "value": "right"}]}]}}
  ]
}
