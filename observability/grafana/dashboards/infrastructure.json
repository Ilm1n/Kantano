{
  "uid": "kantano-infrastructure",
  "title": "Kantano / Infrastructure and telemetry",
  "tags": ["kantano", "infrastructure", "alloy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": [{"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "query": "label_values(up, environment)", "current": {"text": "local", "value": "local"}}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Scrape targets", "description": "Discovered Prometheus scrape targets split into up and down counts.", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum(up{environment=\"$environment\"})", "legendFormat": "up"}, {"refId": "B", "expr": "sum(1 - up{environment=\"$environment\"})", "legendFormat": "down"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "noValue": "No targets"}, "overrides": [{"matcher": {"id": "byName", "options": "down"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}]}},
    {"id": 2, "type": "gauge", "title": "Memory available", "description": "Available host memory. Alert threshold is below 10% for ten minutes.", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "min(node_memory_MemAvailable_bytes{environment=\"$environment\"} / node_memory_MemTotal_bytes{environment=\"$environment\"})"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.1}, {"color": "green", "value": 0.2}]}}}},
    {"id": 3, "type": "gauge", "title": "Filesystem free", "description": "Lowest free ratio across persistent host filesystems. Alert threshold is below 15% for ten minutes.", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "min(node_filesystem_avail_bytes{environment=\"$environment\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{environment=\"$environment\",fstype!~\"tmpfs|overlay\"})"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.15}, {"color": "green", "value": 0.25}]}}}},
    {"id": 4, "type": "stat", "title": "Alloy", "description": "Prometheus scrape health for the Alloy metrics endpoint.", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "min(up{job=\"alloy\",environment=\"$environment\"})"}], "fieldConfig": {"defaults": {"noValue": "NO DATA", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}, {"type": "special", "options": {"match": "null", "result": {"text": "NO DATA", "color": "gray"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 5, "type": "timeseries", "title": "Host CPU utilization", "description": "Average non-idle CPU utilization across host cores.", "gridPos": {"x": 0, "y": 6, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{environment=\"$environment\",mode=\"idle\"}[5m]))", "legendFormat": "CPU"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}},
    {"id": 13, "type": "timeseries", "title": "Host load (1m)", "description": "One-minute host load average, kept separate from CPU percentage.", "gridPos": {"x": 6, "y": 6, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "max(node_load1{environment=\"$environment\"})", "legendFormat": "load1"}], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 6, "type": "timeseries", "title": "Container memory", "description": "Working-set memory for Kantano Compose containers.", "gridPos": {"x": 12, "y": 6, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{environment=\"$environment\",name=~\"/?lighttask_(dev|prod)-.*\"})", "legendFormat": "{{name}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 14, "type": "timeseries", "title": "Container CPU", "description": "CPU usage and throttled CPU seconds per second for Kantano Compose containers.", "gridPos": {"x": 18, "y": 6, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{environment=\"$environment\",name=~\"/?lighttask_(dev|prod)-.*\"}[5m]))", "legendFormat": "CPU {{name}}"},
      {"refId": "B", "expr": "sum by (name) (rate(container_cpu_cfs_throttled_seconds_total{environment=\"$environment\",name=~\"/?lighttask_(dev|prod)-.*\"}[5m]))", "legendFormat": "throttled {{name}}"}
    ], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 7, "type": "timeseries", "title": "Dependency availability", "description": "Database, cache, and broker availability. Each series should remain at one.", "gridPos": {"x": 0, "y": 14, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "min(pg_up{environment=\"$environment\"})", "legendFormat": "PostgreSQL"},
      {"refId": "B", "expr": "min(redis_up{environment=\"$environment\"})", "legendFormat": "Redis"},
      {"refId": "C", "expr": "max(rabbitmq_identity_info{environment=\"$environment\"})", "legendFormat": "RabbitMQ"}
    ], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}}},
    {"id": 8, "type": "timeseries", "title": "Telemetry delivery errors", "description": "Failed metric samples, failed spans, and dropped log entries per second.", "gridPos": {"x": 8, "y": 14, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{environment=\"$environment\"}[5m])) or 0 * max(up{environment=\"$environment\",job=\"alloy\"})", "legendFormat": "failed spans"},
      {"refId": "B", "expr": "sum(rate(prometheus_remote_storage_samples_failed_total{environment=\"$environment\"}[5m])) or 0 * max(up{environment=\"$environment\",job=\"alloy\"})", "legendFormat": "failed samples"},
      {"refId": "C", "expr": "sum(rate(loki_write_dropped_entries_total{environment=\"$environment\"}[5m])) or 0 * max(up{environment=\"$environment\",job=\"alloy\"})", "legendFormat": "dropped logs"}
    ], "fieldConfig": {"defaults": {"unit": "eps", "min": 0}}},
    {"id": 9, "type": "timeseries", "title": "Telemetry throughput", "description": "Metric samples, traces, and log entries exported per second.", "gridPos": {"x": 16, "y": 14, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "kantano-prometheus"}, "targets": [
      {"refId": "A", "expr": "sum(rate(prometheus_remote_storage_samples_total{environment=\"$environment\"}[5m]))", "legendFormat": "metric samples/s"},
      {"refId": "B", "expr": "sum(rate(otelcol_exporter_sent_spans_total{environment=\"$environment\"}[5m]))", "legendFormat": "spans/s"},
      {"refId": "C", "expr": "sum(rate(loki_write_sent_entries_total{environment=\"$environment\"}[5m]))", "legendFormat": "logs/s"}
    ], "fieldConfig": {"defaults": {"unit": "ops", "min": 0}}},
    {"id": 10, "type": "stat", "title": "Grafana Cloud Free quota: current and projected", "description": "Current and projected usage relative to Grafana Cloud Free limits.", "gridPos": {"x": 0, "y": 22, "w": 24, "h": 6}, "datasource": {"type": "prometheus", "uid": "kantano-usage"}, "targets": [
      {"refId": "A", "expr": "max(grafanacloud_instance_active_series) / 10000", "legendFormat": "active series"},
      {"refId": "B", "expr": "max(grafanacloud_org_logs_usage) / 50", "legendFormat": "logs current month"},
      {"refId": "C", "expr": "max(grafanacloud_org_logs_usage) * scalar(days_in_month()) / scalar(day_of_month()) / 50", "legendFormat": "logs projected"},
      {"refId": "D", "expr": "max(grafanacloud_org_traces_usage) / 50", "legendFormat": "traces current month"},
      {"refId": "E", "expr": "max(grafanacloud_org_traces_usage) * scalar(days_in_month()) / scalar(day_of_month()) / 50", "legendFormat": "traces projected"}
    ], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 1}]}}}},
    {"id": 11, "type": "text", "title": "Environment note", "gridPos": {"x": 0, "y": 28, "w": 24, "h": 4}, "options": {"mode": "markdown", "content": "Local host panels describe the Docker Desktop VM; production panels describe the VPS. Cloud quota data comes from the dedicated `grafanacloud-usage` data source."}}
  ]
}
