{
  "uid": "kantano-assistant",
  "title": "Kantano Assistant",
  "tags": [
    "kantano",
    "assistant"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kantano-prometheus"
        },
        "query": "label_values(up, environment)",
        "refresh": 1,
        "current": {
          "text": "local",
          "value": "local"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests by terminal status",
      "type": "timeseries",
      "description": "One terminal outcome per user request. Approval and resume do not count as new requests. Pending requests are not terminal.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(kantano_assistant_runs_total{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^completed$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(failed|unknown)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(cancelled|interrupted)$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "LLM attempts by model and result",
      "type": "timeseries",
      "description": "Includes failed attempts, rate limits, cancellations and fallback attempts.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model, result) (increase(kantano_assistant_llm_calls_total{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "{{provider}} / {{model}} / {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": " / success$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": " / error$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": " / rate_limit$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": " / cancelled$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "LLM latency",
      "type": "timeseries",
      "description": "Individual LLM attempts; excludes user approval waiting. Interpret p95 together with the number of attempts.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model) (rate(kantano_assistant_llm_duration_seconds_sum{environment=\"$environment\",job=\"kantano-api\"}[$__rate_interval])) / sum by (provider, model) (rate(kantano_assistant_llm_duration_seconds_count{environment=\"$environment\",job=\"kantano-api\"}[$__rate_interval]))",
          "legendFormat": "mean {{provider}} / {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(kantano_assistant_llm_duration_seconds_bucket{environment=\"$environment\",job=\"kantano-api\"}[$__rate_interval])))",
          "legendFormat": "p95 {{provider}} / {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Executed tools",
      "type": "timeseries",
      "description": "Only actual read/write calls. Rejected plans and skipped steps do not execute a tool.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, result) (increase(kantano_assistant_tool_calls_total{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "{{tool}} / {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": " / error$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Reported tokens in selected period",
      "type": "stat",
      "description": "Provider-reported usage, not a billing ledger. Missing usage is not counted as zero. Cached/reasoning tokens are already included in input/output.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (increase(kantano_assistant_tokens_total{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "{{direction}}"
        },
        {
          "refId": "B",
          "expr": "sum(increase(kantano_assistant_tokens_total{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Token rate by model",
      "type": "timeseries",
      "description": "LM Studio usage is separate from Google/Groq usage via the provider label.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model, direction) (rate(kantano_assistant_tokens_total{environment=\"$environment\",job=\"kantano-api\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / {{model}} / {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "min": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Tokens per fully accounted request",
      "type": "timeseries",
      "description": "Sum of all LLM calls in a terminal run, including continuation after approval. Runs with incomplete usage, unfinished requests and interrupted streams are excluded. Histogram p95 is approximate.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (increase(kantano_assistant_run_tokens_sum{environment=\"$environment\",job=\"kantano-api\"}[$__range])) / sum by (mode) (increase(kantano_assistant_run_tokens_count{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "mean {{mode}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, mode) (increase(kantano_assistant_run_tokens_bucket{environment=\"$environment\",job=\"kantano-api\"}[$__range])))",
          "legendFormat": "p95 {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Fully accounted requests",
      "type": "stat",
      "description": "Sample count for the tokens-per-request mean and p95. Missing data is not zero.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (increase(kantano_assistant_run_tokens_count{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      }
    },
    {
      "id": 9,
      "title": "Usage availability",
      "type": "stat",
      "description": "Reported vs missing usage for LLM attempts. Missing includes calls stopped before a response or failed without usage.",
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (usage) (increase(kantano_assistant_llm_calls_total{environment=\"$environment\",job=\"kantano-api\"}[$__range]))",
          "legendFormat": "{{usage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      }
    },
    {
      "id": 10,
      "title": "Fallback attempts",
      "type": "stat",
      "description": "Calls to a reserve model after a previous attempt failed; includes fallback within Google.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kantano-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model) (increase(kantano_assistant_llm_calls_total{environment=\"$environment\",job=\"kantano-api\",fallback=\"true\"}[$__range]))",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none"
      }
    }
  ]
}
