# Separate, private S3 bucket used only by the encrypted database backups.
AWS_ACCESS_KEY_ID=change_me_backup_s3_access_key
AWS_SECRET_ACCESS_KEY=change_me_backup_s3_secret_key
AWS_DEFAULT_REGION=ru1
RESTIC_REPOSITORY=s3:https://s3.ru1.storage.beget.cloud/change_me_backup_bucket/kantano-db

# Store this password outside the VPS and GitHub as well. Without it, restores are impossible.
RESTIC_PASSWORD=change_me_long_random_restic_password

# Secret PingZen heartbeat URL. The script calls it after a successful backup.
BACKUP_PINGZEN_URL=https://pingzen.dev/api/v1/ping/change_me_key/change_me_slug
